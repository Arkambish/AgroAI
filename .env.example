# Copy this file to .env and fill in your key. .env is git-ignored — never
# commit a real key.

# Required for POST /api/chat (the dashboard's XAI chat assistant). Without
# it, /api/chat returns 503 and every other endpoint is unaffected.
# Get a free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Defaults to a free-tier model
# (nvidia/nemotron-3-super-120b-a12b:free). Free models on OpenRouter change
# over time — see what's currently free at
# https://openrouter.ai/models?max_price=0 and override here if the default
# gets deprecated or is too rate-limited.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Sent as the HTTP-Referer header OpenRouter uses to attribute
# free-tier usage; doesn't need to be publicly reachable.
# OPENROUTER_SITE_URL=http://localhost:3000
